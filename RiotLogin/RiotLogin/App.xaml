<Application x:Class="RiotLogin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:RiotLogin"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Right-click menu shared by both account grids -->
            <ContextMenu x:Key="AccountMenu" x:Shared="False">
                <MenuItem Header="Copy Username" Tag="Username" Click="CopyField_Click" />
                <MenuItem Header="Copy Password" Tag="Password" Click="CopyField_Click" />
                <MenuItem Header="Copy Riot ID" Tag="RiotID" Click="CopyField_Click" />
            </ContextMenu>

            <local:RankBrushConverter x:Key="RankBrush" />
            <local:StatusBrushConverter x:Key="StatusBrush" />

            <!-- Riot ID with the account's profile icon (filled by Pull Data) -->
            <DataTemplate x:Key="RiotIdCell">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Border.OpacityMask>
                            <VisualBrush><VisualBrush.Visual><Ellipse Width="22" Height="22" Fill="Black" /></VisualBrush.Visual></VisualBrush>
                        </Border.OpacityMask>
                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding RiotID}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <!-- Grid cells: numbers right-aligned, ranks coloured by tier -->
            <Style x:Key="NumCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="RankCell" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource RankBrush}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="StatusCell" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusBrush}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
